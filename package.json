{
  "name": "kairos",
  "version": "0.1.0",
  "description": "Offline-first Eisenhower Matrix desktop app for macOS, Windows, and Linux.",
  "author": {
    "name": "calabchen",
    "email": "162004123@qq.com"
  },
  "license": "MIT",
  "private": true,
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "node scripts/ensure-electron.mjs && concurrently -k \"vite --host 127.0.0.1\" \"tsc -p tsconfig.electron.json --watch\" \"wait-on http://127.0.0.1:5173 dist-electron/main/main.js && electron .\"",
    "build": "pnpm typecheck && tsc -p tsconfig.electron.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "package": "pnpm build && electron-builder"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "electron": "^39.8.10",
    "electron-builder": "^26.0.12",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.calabchen.kairos",
    "productName": "Kairos",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "artifactName": "ap-mac-xnu.${ext}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "ms-win-nt#.${ext}"
    },
    "linux": {
      "target": [
        "deb"
      ],
      "artifactName": "lf-lin-lnx.${ext}",
      "category": "Utility"
    }
  }
}
